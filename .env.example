# ============================================================================
# Relay Rider Rule 2202 — Supabase environment variables
# ============================================================================
# Copy this file to .env.local (which is gitignored) before running the app.
# Do NOT commit real credentials. .env.local is already in .gitignore.
#
# Required for the Rule 2202 Partner Console to load real data from Supabase.
# When these are absent, the Partner Console falls back to its built-in mock
# fixtures and runs in demonstration mode with no network calls.
# ============================================================================

# Supabase project URL — from Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key — from Project Settings → API → Anon public key
# This key is safe to ship to the browser; RLS polices every row at the DB.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example
